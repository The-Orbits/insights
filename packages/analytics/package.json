{
  "name": "@useorbits/analytics",
  "version": "0.1.1",
  "description": "Privacy-friendly page views for apps on Orbits: no cookies, nothing personal stored.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/the-orbits/insights.git", "directory": "packages/analytics" },
  "homepage": "https://orbits.africa",
  "keywords": ["analytics", "orbits", "privacy", "page views"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js", "require": "./dist/react.cjs" },
    "./next": { "types": "./dist/next.d.ts", "import": "./dist/next.js", "require": "./dist/next.cjs" }
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
