{
  "name": "@useorbits/analytics",
  "version": "0.2.0",
  "description": "Privacy-friendly page views and custom events for apps on Orbits: no cookies, nothing personal stored.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Orbits/insights.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://orbits.africa",
  "keywords": [
    "analytics",
    "orbits",
    "privacy",
    "page views",
    "events"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "astro"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "import": "./dist/sveltekit.js",
      "require": "./dist/sveltekit.cjs"
    },
    "./astro": "./astro/Analytics.astro",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "next": ">=13",
    "vue": ">=3",
    "@sveltejs/kit": ">=1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
