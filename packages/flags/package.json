{
  "name": "@useorbits/flags",
  "version": "0.1.1",
  "description": "Feature flags for apps on Orbits: switch code on for your team, a share of visitors or everyone, without a redeploy.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/The-Orbits/insights.git", "directory": "packages/flags" },
  "homepage": "https://orbits.africa",
  "keywords": ["feature flags", "flags", "rollout", "orbits"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
